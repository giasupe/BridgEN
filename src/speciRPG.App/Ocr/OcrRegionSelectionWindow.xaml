<Window x:Class="speciRPG.App.Ocr.OcrRegionSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Canvas x:Name="SelectionCanvas"
            Background="#01000000"
            MouseLeftButtonDown="SelectionCanvas_MouseLeftButtonDown"
            MouseMove="SelectionCanvas_MouseMove"
            MouseLeftButtonUp="SelectionCanvas_MouseLeftButtonUp"
            MouseRightButtonDown="SelectionCanvas_MouseRightButtonDown">
        <Rectangle x:Name="SelectionRectangle"
                   Visibility="Collapsed"
                   Stroke="#FF37A3FF"
                   StrokeThickness="2"
                   Fill="#4437A3FF"
                   IsHitTestVisible="False" />
        <Border Canvas.Left="16"
                Canvas.Top="16"
                Padding="12,8"
                Background="#E51C2027"
                CornerRadius="6"
                IsHitTestVisible="False">
            <TextBlock Text="読み取る範囲をドラッグで選択　・　右クリックでキャンセル"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold" />
        </Border>
    </Canvas>
</Window>
