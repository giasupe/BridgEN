<Window x:Class="speciRPG.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="speciRPG"
        Width="760"
        Height="580"
        MinWidth="620"
        MinHeight="480"
        Background="#F4F5F7">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="speciRPG"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#20242A" />
            <TextBlock Margin="0,8,0,0"
                       Text="2D RPGの会話を読み取り、日本語訳を画面に表示します。"
                       FontSize="15"
                       Foreground="#59616B" />
        </StackPanel>

        <Border Grid.Row="2"
                Padding="20"
                Background="White"
                BorderBrush="#DDE1E6"
                BorderThickness="1"
                CornerRadius="10">
            <StackPanel>
                <TextBlock Text="処理の流れ"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#20242A" />
                <TextBlock Margin="0,14,0,0"
                           Text="1. 決定キーや固定範囲の確認で会話枠を検知"
                           FontSize="15"
                           Foreground="#333A43" />
                <TextBlock Margin="0,8,0,0"
                           Text="2. 文字の変化が止まったら、一度だけOCR"
                           FontSize="15"
                           Foreground="#333A43" />
                <TextBlock Margin="0,8,0,0"
                           Text="3. 話者と会話の文脈を付けて翻訳"
                           FontSize="15"
                           Foreground="#333A43" />
                <TextBlock Margin="0,8,0,0"
                           Text="4. 翻訳文だけを通知表示"
                           FontSize="15"
                           Foreground="#333A43" />

                <Border Margin="0,16,0,0"
                        Padding="10"
                        Background="#EEF6FF"
                        CornerRadius="6">
                    <StackPanel>
                        <TextBlock Text="キーボード監視"
                                   FontWeight="SemiBold"
                                   Foreground="#20242A" />
                        <TextBlock x:Name="KeyboardStatusText"
                                   Margin="0,4,0,0"
                                   Text="監視を開始しています..."
                                   Foreground="#245A8D" />
                        <TextBlock x:Name="LastKeyText"
                                   Margin="0,4,0,0"
                                   Text="最後に検知したキー: なし"
                                   Foreground="#333A43" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="ZとEnterを監視します。キー入力はゲームにも届きます。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="#59616B" />
                    </StackPanel>
                </Border>

                <Border Margin="0,12,0,0"
                        Padding="10"
                        Background="#F4F5F7"
                        CornerRadius="6">
                    <TextBlock Text="開発段階：アプリの土台を作成中。キャプチャ・OCR・翻訳APIはこれから接続します。"
                               TextWrapping="Wrap"
                               Foreground="#59616B" />
                </Border>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4"
                   Text="初期翻訳候補: Gemini 3.1 Flash-Lite  /  翻訳サービスは後から差し替え可能"
                   FontSize="12"
                   Foreground="#737B85" />
    </Grid>
</Window>