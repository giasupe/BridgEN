<Window x:Class="BridgEN.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BridgEN" Width="760" Height="860" MinWidth="620" MinHeight="480"
        Background="#F4F5F7">
    <Window.Resources>
        <Style x:Key="ResultBox" TargetType="TextBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="MinHeight" Value="80" />
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <DataTemplate x:Key="TimingRowTemplate">
            <DockPanel Margin="0,3,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Margin="12,0,0,0"
                           Foreground="#245A8D" TextAlignment="Right" />
                <TextBlock Text="{Binding Name}" Foreground="#333A43" />
            </DockPanel>
        </DataTemplate>
    </Window.Resources>
    <Border Margin="20" Padding="20" Background="White" BorderBrush="#DDE1E6"
            BorderThickness="1" CornerRadius="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Expander x:Name="ConnectionSettingsExpander" Header="翻訳の接続設定" Margin="0,0,0,14">
                    <StackPanel Margin="0,8,0,0">
                        <ComboBox x:Name="ConnectionModeComboBox" SelectedIndex="0"
                                  SelectionChanged="ConnectionModeComboBox_SelectionChanged">
                            <ComboBoxItem Content="中継サーバー（配布版）" />
                            <ComboBoxItem Content="Geminiへ直接接続（開発用・環境変数のキーを使用）" />
                        </ComboBox>
                        <StackPanel x:Name="RelaySettingsPanel">
                            <TextBlock Text="サーバーURL" Margin="0,8,0,4" />
                            <TextBox x:Name="RelayUrlTextBox" Padding="6" />
                            <TextBlock Text="招待トークン（中継サーバー用）" Margin="0,8,0,4" />
                            <PasswordBox x:Name="InviteTokenBox" Padding="6" />
                        </StackPanel>
                        <TextBlock x:Name="DirectConnectionHelpText" Visibility="Collapsed"
                                   Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#59616B"
                                   Text="招待トークンは不要です。環境変数 GEMINI_API_KEY（または GOOGLE_API_KEY）に設定された自分のAPIキーで、Geminiへ直接接続します。" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="接続設定を保存" Padding="12,6" Click="SaveConnectionSettings_Click" />
                            <Button x:Name="DeleteInviteTokenButton" Content="保存したトークンを削除" Padding="12,6" Margin="8,0,0,0"
                                    Click="DeleteInviteToken_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ConnectionSettingsStatusText" Margin="0,6,0,0"
                                   Foreground="#59616B" TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="操作モード" FontWeight="SemiBold" />
                    <ComboBox x:Name="OperationModeComboBox" Margin="0,6,0,0" SelectedIndex="0"
                              SelectionChanged="OperationModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="オートマチック" />
                        <ComboBoxItem Content="マニュアル" />
                    </ComboBox>
                    <StackPanel x:Name="ManualHotkeyPanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <TextBlock Text="実行キー（下の欄をクリックして、設定するキーを押してください）" TextWrapping="Wrap" />
                        <TextBox x:Name="ManualHotkeyBox" Text="F8" IsReadOnly="True" Padding="6" Margin="0,4,0,0"
                                 PreviewKeyDown="ManualHotkeyBox_PreviewKeyDown" />
                        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#59616B" TextWrapping="Wrap"
                                   Text="Ctrl・Shift・Altなどとの組み合わせも設定できます。設定は自動で保存します。キー入力はゲームにも届きます。" />
                    </StackPanel>
                    <TextBlock x:Name="OperationModeHelpText" Margin="0,6,0,0" FontSize="12"
                               Foreground="#59616B" TextWrapping="Wrap" />
                    <TextBlock x:Name="OperationSettingsStatusText" Margin="0,4,0,0" FontSize="12"
                               Foreground="#245A8D" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Text="対象ウィンドウ" FontWeight="SemiBold" />
                <DockPanel Margin="0,6,0,0">
                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="12,6"
                            Content="一覧を更新" Click="RefreshWindowsButton_Click" />
                    <ComboBox x:Name="TargetWindowComboBox" Height="32" DisplayMemberPath="DisplayName"
                              SelectionChanged="TargetWindowComboBox_SelectionChanged" />
                </DockPanel>
                <TextBlock x:Name="TargetWindowStatusText" Margin="0,6,0,0" FontSize="12"
                           Text="対象ウィンドウを選択してください。" Foreground="#59616B" TextWrapping="Wrap" />
                <DockPanel Margin="0,10,0,0">
                    <Button x:Name="SelectOcrRegionButton" DockPanel.Dock="Left" Padding="12,6"
                            Content="読む範囲を選択" IsEnabled="False" Click="SelectOcrRegionButton_Click" />
                    <TextBlock x:Name="OcrRegionStatusText" Margin="10,0,0,0" VerticalAlignment="Center"
                               Text="範囲は未選択です。" Foreground="#59616B" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                    <Button x:Name="StartOcrButton" Padding="14,7" Content="OCRを開始" Click="StartOcrButton_Click" />
                    <Button x:Name="StopOcrButton" Margin="8,0,0,0" Padding="14,7" Content="停止"
                            IsEnabled="False" Click="StopOcrButton_Click" />
                </StackPanel>
                <TextBlock x:Name="OcrStatusText" Margin="0,8,0,0" Foreground="#245A8D" TextWrapping="Wrap"
                           Text="対象ウィンドウを選んでから開始してください。" />

                <TextBlock Margin="0,16,0,0" Text="OCR結果" FontWeight="SemiBold" />
                <TextBox x:Name="RecognizedTextBox" Style="{StaticResource ResultBox}" />
                <TextBlock Margin="0,12,0,0" Text="翻訳結果" FontWeight="SemiBold" />
                <TextBox x:Name="TranslationResultTextBox" Style="{StaticResource ResultBox}" />

                <Expander Margin="0,16,0,0" Header="処理時間" IsExpanded="False">
                    <Border Margin="0,6,0,0" Padding="12" Background="#F4F5F7" CornerRadius="6">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最新のOCR処理" FontWeight="SemiBold" FontSize="12" />
                                    <ItemsControl x:Name="OcrTimingsList" Margin="0,4,0,0"
                                                  ItemTemplate="{StaticResource TimingRowTemplate}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="現在の文章の翻訳処理" FontWeight="SemiBold" FontSize="12" />
                                    <ItemsControl x:Name="TranslationTimingsList" Margin="0,4,0,0"
                                                  ItemTemplate="{StaticResource TimingRowTemplate}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TimingHelpText" Margin="0,10,0,0" FontSize="11" Foreground="#59616B" TextWrapping="Wrap"
                                       Text="単位: ms（1,000 ms = 1秒）。取得→表示開始は訳が最初に表示されるまで。描画完了と取得前の待ち時間は含みません。OCR間隔: 確認中250 ms／確定後400 ms。" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Margin="0,16,0,0" Header="キーボード監視">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock x:Name="KeyboardStatusText" Text="監視を開始しています..." Foreground="#245A8D" TextWrapping="Wrap" />
                        <TextBlock x:Name="LastKeyText" Margin="0,4,0,0" Text="最後に検知したキー: なし" />
                        <TextBlock x:Name="DetectedKeyCountText" Margin="0,4,0,0" Text="対象ウィンドウ内の入力回数: 0" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
